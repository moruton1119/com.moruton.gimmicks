/* ============================================
   MetamorphoseWindow — Magical Girl Theme
   🌙 Dark (Moonlight) / ☀️ Light (Daylight)
   ============================================ */

/* ═══════════════════════════════════════════════
   DARK THEME (Moonlight) — Default
   ═══════════════════════════════════════════════ */
.app-root {
    /* Moonlight palette */
    --bg-night: #1a0e2e;
    --bg-deep: #13091f;
    --bg-elevated: #241638;
    --bg-hover: #2e1d4a;
    --bg-input: #1c1130;
    --topbar-bg: #241638;
    --sidebar-bg: #13091f;
    --banner-bg: #0f0719;

    --accent: #ff6b9d;          /* Hot pink */
    --accent-hover: #ff8fb8;     /* Lighter pink */
    --accent-bg: rgba(255, 107, 157, 0.12);
    --accent-border: rgba(255, 107, 157, 0.3);
    --accent-purple: #c4a8ff;    /* Lavender */
    --accent-green: #b4f8c8;     /* Mint sparkle */
    --accent-orange: #ffd93d;    /* Star gold */
    --accent-red: #ff5e7e;
    --accent-cyan: #7defff;      /* Magic cyan */

    --border: #3a2658;
    --border-subtle: #2d1b4a;
    --text: #f0e6ff;
    --text-secondary: #c4b8e0;
    --text-dim: #7a6a9e;

    --glow-pink: rgba(255, 107, 157, 0.15);
    --glow-purple: rgba(196, 168, 255, 0.12);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;

    flex: 1;
    flex-direction: column;
    background-color: var(--bg-night);
    color: var(--text);
    font-size: 13px;
}

/* ═══════════════════════════════════════════════
   LIGHT THEME (Daylight) — Add .light-theme class
   ═══════════════════════════════════════════════ */
.app-root.light-theme {
    --bg-night: #fff5f8;
    --bg-deep: #fce4ec;
    --bg-elevated: #ffffff;
    --bg-hover: #f3d4e6;
    --bg-input: #fdf0f5;
    --topbar-bg: #ffffff;
    --sidebar-bg: #fce4ec;
    --banner-bg: #f8d7e8;

    --accent: #e91e63;           /* Strong pink */
    --accent-hover: #f06292;      /* Soft pink */
    --accent-bg: rgba(233, 30, 99, 0.08);
    --accent-border: rgba(233, 30, 99, 0.25);
    --accent-purple: #9c27b0;     /* Royal purple */
    --accent-green: #66bb6a;      /* Fresh green */
    --accent-orange: #ffa726;     /* Warm gold */
    --accent-red: #ef5350;
    --accent-cyan: #26c6da;       /* Bright cyan */

    --border: #e8c4d8;
    --border-subtle: #f0d4e2;
    --text: #4a1942;
    --text-secondary: #7b4a6e;
    --text-dim: #b0809e;

    --glow-pink: rgba(233, 30, 99, 0.06);
    --glow-purple: rgba(156, 39, 176, 0.05);
}

/* ═══════════════════════════════════════════════
   Top Bar
   ═══════════════════════════════════════════════ */
.topbar {
    height: 44px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 12px;
    background-color: var(--topbar-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--accent);
}

.topbar-title {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--accent);
    letter-spacing: 0.5px;
    text-shadow: 0 0 var(--glow-pink);
}

/* --- Theme Toggle --- */
.theme-toggle {
    width: 36px;
    height: 28px;
    font-size: 16px;
    color: var(--accent);
    background-color: var(--accent-bg);
    border-width: 1px;
    border-color: var(--accent-border);
    border-radius: var(--radius-sm);
    margin-left: 8px;
    margin-right: 4px;
    transition: background-color 0.2s;
}

.theme-toggle:hover {
    background-color: var(--glow-pink);
}

/* --- Language Bar --- */
.lang-bar {
    flex-direction: row;
    background-color: var(--bg-input);
    border-radius: var(--radius-sm);
    padding: 3px;
}

.lang-btn {
    flex: 1;
    height: 24px;
    min-width: 36px;
    font-size: 11px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: normal;
    margin-left: 1px;
    margin-right: 1px;
    transition: background-color 0.15s, color 0.15s;
}

.lang-btn:hover {
    color: var(--text);
    background-color: var(--bg-hover);
}

.lang-btn.selected {
    color: #ffffff;
    background-color: var(--accent);
    -unity-font-style: bold;
}

/* ═══════════════════════════════════════════════
   Main Area
   ═══════════════════════════════════════════════ */
.main-area {
    flex: 1;
    flex-direction: row;
    overflow: hidden;
}

/* --- Sidebar --- */
.sidebar {
    width: 56px;
    background-color: var(--sidebar-bg);
    border-right-width: 2px;
    border-right-color: var(--accent);
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.sidebar-header {
    font-size: 8px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.sidebar-divider {
    width: 32px;
    height: 2px;
    background-color: var(--accent-border);
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 1px;
}

.sidebar-spacer {
    flex: 1;
}

/* --- Numbered Nav Buttons --- */
.nav-num {
    width: 40px;
    height: 40px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-dim);
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 6px;
    transition: background-color 0.15s, color 0.15s;
}

.nav-num:hover {
    background-color: var(--bg-hover);
    color: var(--text);
    border-color: var(--accent-border);
}

.nav-num.active {
    color: #ffffff;
    background-color: var(--accent);
    border-color: var(--accent);
}

/* --- Link Nav Buttons (Booth, Discord, Dev) --- */
.nav-link {
    width: 40px;
    height: 32px;
    font-size: 11px;
    color: var(--text-secondary);
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 4px;
    transition: background-color 0.15s, color 0.15s;
}

.nav-link:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.dev-btn {
    color: var(--accent-orange);
}

.dev-btn:hover {
    color: var(--accent-orange);
    background-color: rgba(255, 217, 61, 0.12);
}

.dev-btn.active {
    color: #ffffff;
    background-color: var(--accent-orange);
}

/* ═══════════════════════════════════════════════
   Content Panel
   ═══════════════════════════════════════════════ */
.content-panel {
    flex: 1;
    background-color: var(--bg-night);
}

#scroll-content {
    --unity-scroll-view-container-border-width: 0;
}

.pages-container {
    padding: 20px 24px;
    flex-direction: column;
}

/* --- Pages --- */
.page {
    flex-direction: column;
}

.page-desc {
    color: var(--text-secondary);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 16px;
    line-height: 1.5;
}

/* ═══════════════════════════════════════════════
   Field Group — Magical Girl Card
   ═══════════════════════════════════════════════ */
.field-group {
    background-color: var(--bg-elevated);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 12px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.field-group-title {
    font-size: 11px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--accent-purple);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-border);
}

/* --- Field Slot --- */
.field-slot {
    margin-bottom: 4px;
}

.field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-secondary);
    min-width: 100px;
}

/* ═══════════════════════════════════════════════
   Part Section
   ═══════════════════════════════════════════════ */
.part-section {
    background-color: var(--glow-purple);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 10px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --- Preview Row --- */
.preview-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 44px;
    margin-top: 8px;
    align-items: center;
}

.preview-thumb {
    width: 64px;
    height: 64px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: var(--accent-border);
    object-fit: scale-down;
}

/* ═══════════════════════════════════════════════
   Fade Section
   ═══════════════════════════════════════════════ */
.fade-section {
    background-color: var(--glow-purple);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 10px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.fade-part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent-orange);
    margin-bottom: 8px;
    text-transform: uppercase;
}

/* ═══════════════════════════════════════════════
   Colabo Shop
   ═══════════════════════════════════════════════ */
.colabo-preview {
    justify-content: center;
    align-items: center;
    height: 140px;
    margin-bottom: 8px;
}

.colabo-shop-image {
    width: 128px;
    height: 128px;
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: var(--accent-border);
}

.link-btn {
    height: 30px;
    font-size: 12px;
    color: var(--accent);
    background-color: var(--accent-bg);
    border-width: 1px;
    border-color: var(--accent-border);
    border-radius: var(--radius-sm);
    margin-bottom: 8px;
    transition: background-color 0.15s;
}

.link-btn:hover {
    background-color: var(--glow-pink);
}

/* --- HelpBox Override --- */
.page > HelpBox,
.field-group > HelpBox {
    margin-top: 4px;
    margin-bottom: 10px;
}

/* ═══════════════════════════════════════════════
   Dev Page
   ═══════════════════════════════════════════════ */
.dev-page .field-slot {
    margin-bottom: 3px;
}

.dev-page .field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-dim);
    min-width: 120px;
}

.dev-toggle-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.part-toggle {
    height: 26px;
    min-width: 90px;
    flex: 1;
    font-size: 11px;
    color: #ffffff;
    background-color: var(--accent);
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 2px;
    transition: background-color 0.15s;
}

.part-toggle:hover {
    background-color: var(--accent-hover);
}

.part-toggle-off {
    color: var(--text-dim);
    background-color: var(--bg-input);
}

/* ═══════════════════════════════════════════════
   Opening Animation
   ═══════════════════════════════════════════════ */
#opening-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

/* ═══════════════════════════════════════════════
   Banner
   ═══════════════════════════════════════════════ */
.banner {
    background-color: var(--banner-bg);
    border-top-width: 2px;
    border-top-color: var(--accent-border);
    padding: 12px 16px 14px;
}

.banner-cards {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: scroll;
}

.banner-card {
    width: 260px;
    height: 88px;
    margin-right: 10px;
    border-radius: var(--radius-md);
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    padding: 8px;
    overflow: hidden;
    transition: border-color 0.15s, background-color 0.15s;
}

.banner-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-hover);
}

.banner-card-image {
    width: 72px;
    height: 72px;
    margin-right: 10px;
    border-radius: var(--radius-sm);
    object-fit: scale-and-crop;
    background-color: var(--bg-input);
    flex-shrink: 0;
}

.banner-card-label {
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    flex: 1;
    overflow: hidden;
}

.banner-card-loading {
    color: var(--text-dim);
    font-size: 11px;
}
