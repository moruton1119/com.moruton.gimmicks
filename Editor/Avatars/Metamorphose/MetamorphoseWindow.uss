/* ============================================
   MetamorphoseWindow — Tokyo Night Inspired
   ============================================ */

.app-root {
    /* Tokyo Night palette */
    --bg-night: #1a1b26;
    --bg-deep: #16161e;
    --bg-elevated: #24283b;
    --bg-hover: #2f334d;
    --bg-input: #1f2335;
    --topbar-bg: #1f2335;
    --sidebar-bg: #16161e;
    --banner-bg: #131420;

    --accent: #7aa2f7;
    --accent-hover: #89b4fa;
    --accent-bg: rgba(122, 162, 247, 0.12);
    --accent-border: rgba(122, 162, 247, 0.3);
    --accent-purple: #bb9af7;
    --accent-green: #9ece6a;
    --accent-orange: #e0af68;
    --accent-red: #f7768e;

    --border: #2a2e42;
    --border-subtle: #22253a;
    --text: #c0caf5;
    --text-secondary: #9aa5ce;
    --text-dim: #565f89;

    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;

    flex: 1;
    flex-direction: column;
    background-color: var(--bg-night);
    color: var(--text);
    font-size: 13px;
}

/* --- Top Bar --- */
.topbar {
    height: 42px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 12px;
    background-color: var(--topbar-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.topbar-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: #fff;
    letter-spacing: 0.3px;
}

/* --- Language Bar --- */
.lang-bar {
    flex-direction: row;
    background-color: var(--bg-input);
    border-radius: var(--radius-sm);
    padding: 3px;
}

.lang-btn {
    flex: 1;
    height: 24px;
    min-width: 36px;
    font-size: 11px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: normal;
    margin-left: 1px;
    margin-right: 1px;
    transition: background-color 0.15s, color 0.15s;
}

.lang-btn:hover {
    color: var(--text);
    background-color: var(--bg-hover);
}

.lang-btn.selected {
    color: #fff;
    background-color: var(--accent);
    -unity-font-style: bold;
}

/* --- Main Area --- */
.main-area {
    flex: 1;
    flex-direction: row;
    overflow: hidden;
}

/* --- Sidebar --- */
.sidebar {
    width: 56px;
    background-color: var(--sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--border);
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.sidebar-header {
    font-size: 8px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-dim);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.sidebar-divider {
    width: 32px;
    height: 1px;
    background-color: var(--border);
    margin-top: 8px;
    margin-bottom: 8px;
}

.sidebar-spacer {
    flex: 1;
}

/* --- Numbered Nav Buttons --- */
.nav-num {
    width: 40px;
    height: 40px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-dim);
    background-color: var(--bg-elevated);
    border-width: 0;
    border-radius: var(--radius-md);
    margin-bottom: 6px;
    transition: background-color 0.15s, color 0.15s, transform 0.1s;
}

.nav-num:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.nav-num.active {
    color: #fff;
    background-color: var(--accent);
}

/* --- Link Nav Buttons (Booth, Discord, Dev) --- */
.nav-link {
    width: 40px;
    height: 32px;
    font-size: 11px;
    color: var(--text-secondary);
    background-color: var(--bg-elevated);
    border-width: 0;
    border-radius: var(--radius-md);
    margin-bottom: 4px;
    transition: background-color 0.15s, color 0.15s;
}

.nav-link:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.dev-btn {
    color: var(--accent-orange);
}

.dev-btn:hover {
    color: var(--accent-orange);
    background-color: rgba(224, 175, 104, 0.12);
}

.dev-btn.active {
    color: #fff;
    background-color: var(--accent-orange);
}

/* --- Content Panel --- */
.content-panel {
    flex: 1;
    background-color: var(--bg-night);
}

#scroll-content {
    --unity-scroll-view-container-border-width: 0;
}

.pages-container {
    padding: 20px 24px;
    flex-direction: column;
}

/* --- Pages --- */
.page {
    flex-direction: column;
}

.page-desc {
    color: var(--text-secondary);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 16px;
    line-height: 1.5;
}

/* --- Field Group --- */
.field-group {
    background-color: var(--bg-elevated);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 12px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.field-group-title {
    font-size: 11px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--accent-purple);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(187, 154, 247, 0.15);
}

/* --- Field Slot --- */
.field-slot {
    margin-bottom: 4px;
}

.field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-secondary);
    min-width: 100px;
}

/* --- Part Section --- */
.part-section {
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 10px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-dim);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --- Preview Row --- */
.preview-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 44px;
    margin-top: 8px;
    align-items: center;
}

.preview-thumb {
    width: 64px;
    height: 64px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--border);
    object-fit: scale-down;
}

/* --- Fade Section --- */
.fade-section {
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 10px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.fade-part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent-orange);
    margin-bottom: 8px;
    text-transform: uppercase;
}

/* --- Colabo Shop --- */
.colabo-preview {
    justify-content: center;
    align-items: center;
    height: 140px;
    margin-bottom: 8px;
}

.colabo-shop-image {
    width: 128px;
    height: 128px;
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--border);
}

.link-btn {
    height: 30px;
    font-size: 12px;
    color: var(--accent);
    background-color: var(--accent-bg);
    border-width: 1px;
    border-color: var(--accent-border);
    border-radius: var(--radius-sm);
    margin-bottom: 8px;
    transition: background-color 0.15s;
}

.link-btn:hover {
    background-color: rgba(122, 162, 247, 0.2);
}

/* --- HelpBox Override --- */
.page > HelpBox,
.field-group > HelpBox {
    margin-top: 4px;
    margin-bottom: 10px;
}

/* --- Dev Page --- */
.dev-page .field-slot {
    margin-bottom: 3px;
}

.dev-page .field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-dim);
    min-width: 120px;
}

.dev-toggle-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.part-toggle {
    height: 26px;
    min-width: 90px;
    flex: 1;
    font-size: 11px;
    color: #fff;
    background-color: var(--accent-green);
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 2px;
    transition: background-color 0.15s;
}

.part-toggle:hover {
    opacity: 0.85;
}

.part-toggle-off {
    color: var(--text-dim);
    background-color: var(--bg-input);
}

/* --- Banner --- */
.banner {
    background-color: var(--banner-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
    padding: 12px 16px 14px;
}

.banner-cards {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: scroll;
}

.banner-card {
    width: 260px;
    height: 88px;
    margin-right: 10px;
    border-radius: var(--radius-md);
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--border);
    flex-direction: row;
    align-items: center;
    padding: 8px;
    overflow: hidden;
    transition: border-color 0.15s, background-color 0.15s;
}

.banner-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-hover);
}

.banner-card-image {
    width: 72px;
    height: 72px;
    margin-right: 10px;
    border-radius: var(--radius-sm);
    object-fit: scale-and-crop;
    background-color: var(--bg-input);
    flex-shrink: 0;
}

.banner-card-label {
    color: var(--text);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    flex: 1;
    overflow: hidden;
}

.banner-card-loading {
    color: var(--text-dim);
    font-size: 11px;
}
