/* ═══════════════════════════════════════════════
   Moonlight Theme — Dark Magical Girl
   全色 CSS変数で制御 — ハードコードなし
   ═══════════════════════════════════════════════ */

/* ★ Moonlight CSS変数定義 */
.theme-moonlight {
    --bg-night: #1a0e2e;
    --bg-deep: #13091f;
    --bg-elevated: #241638;
    --bg-hover: #2e1d4a;
    --bg-input: #1c1130;
    --topbar-bg: #241638;
    --sidebar-bg: #13091f;
    --banner-bg: #0f0719;
    --helpbox-bg: #28193e;

    --accent: #ff6b9d;
    --accent-hover: #ff8fb8;
    --accent-bg: rgba(255, 107, 157, 0.12);
    --accent-border: rgba(255, 107, 157, 0.3);
    --accent-purple: #c4a8ff;
    --accent-green: #b4f8c8;
    --accent-orange: #ffd93d;
    --accent-red: #ff5e7e;
    --accent-cyan: #7defff;

    --border: #3a2658;
    --border-subtle: #2d1b4a;
    --text: #f0e6ff;
    --text-secondary: #c4b8e0;
    --text-dim: #7a6a9e;

    --glow-pink: rgba(255, 107, 157, 0.15);
    --glow-purple: rgba(196, 168, 255, 0.12);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
}

/* ═══════════════════════════════════════════════
   Layout elements
   ═══════════════════════════════════════════════ */

.theme-moonlight .content-panel {
    background-color: var(--bg-night);
}

.theme-moonlight .pages-container {
    background-color: var(--bg-night);
}

.theme-moonlight .field-group {
    background-color: var(--bg-elevated);
    border-color: var(--border-subtle);
}

.theme-moonlight .field-group-title {
    color: var(--accent-purple);
    border-bottom-color: var(--accent-border);
}

.theme-moonlight HelpBox {
    background-color: var(--helpbox-bg);
    border-color: var(--accent-border);
    color: var(--text-secondary);
}

.theme-moonlight .part-card {
    background-color: var(--bg-elevated);
    border-color: var(--border-subtle);
}

.theme-moonlight .part-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-hover);
}

.theme-moonlight .fade-section {
    background-color: var(--glow-purple);
    border-color: var(--border-subtle);
}

/* ═══════════════════════════════════════════════
   Unity標準要素
   ═══════════════════════════════════════════════ */

/* TextField / ObjectField 入力欄 */
.theme-moonlight .unity-base-field__input {
    background-color: var(--bg-input);
    border-color: var(--border);
    color: var(--text);
}

.theme-moonlight .unity-object-field__object {
    background-color: var(--bg-input);
    color: var(--text);
}

.theme-moonlight .unity-color-field {
    background-color: var(--bg-input);
    border-color: var(--border);
}

.theme-moonlight .unity-integer-field,
.theme-moonlight .unity-float-field {
    background-color: var(--bg-input);
    color: var(--text);
}

.theme-moonlight .unity-property-field__label {
    color: var(--text-secondary) !important;
}

.theme-moonlight .unity-foldout {
    color: var(--text);
}

.theme-moonlight .unity-foldout__text {
    color: var(--text);
}

.theme-moonlight .unity-toggle {
    color: var(--text);
}

/* ═══════════════════════════════════════════════
   配列・リスト要素 (ReorderableList)
   ═══════════════════════════════════════════════ */

.theme-moonlight .unity-list-view {
    background-color: var(--bg-input);
    border-color: var(--border-subtle);
}

.theme-moonlight .unity-list-view__reorderable-item {
    background-color: var(--bg-elevated);
    border-color: var(--border-subtle);
}

.theme-moonlight .unity-list-view__reorderable-item:hover {
    background-color: var(--bg-hover);
}

.theme-moonlight .unity-list-view__reorderable-item__drag-handle {
    background-color: var(--border);
}

.theme-moonlight .unity-list-view__reorderable-item__drag-handle:hover {
    background-color: var(--accent);
}

.theme-moonlight .unity-list-view__reorderable-item__remove-button {
    color: var(--text-dim);
    background-color: transparent;
}

.theme-moonlight .unity-list-view__reorderable-item__remove-button:hover {
    color: var(--accent-red);
    background-color: var(--bg-hover);
}

.theme-moonlight .unity-array-size-field__input {
    background-color: var(--bg-input);
    color: var(--text);
}

.theme-moonlight .unity-foldout__toggle {
    color: var(--accent);
}

.theme-moonlight .unity-scroll-view {
    background-color: transparent;
}
