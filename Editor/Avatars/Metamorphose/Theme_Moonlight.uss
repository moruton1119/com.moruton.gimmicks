/* ═══════════════════════════════════════════════
   Moonlight Theme — Dark Magical Girl
   ═══════════════════════════════════════════════ */

/* ★ Moonlight CSS変数定義 */
.theme-moonlight {
    --bg-night: #1a0e2e;
    --bg-deep: #13091f;
    --bg-elevated: #241638;
    --bg-hover: #2e1d4a;
    --bg-input: #1c1130;
    --topbar-bg: #241638;
    --sidebar-bg: #13091f;
    --banner-bg: #0f0719;
    --helpbox-bg: #28193e;

    --accent: #ff6b9d;
    --accent-hover: #ff8fb8;
    --accent-bg: rgba(255, 107, 157, 0.12);
    --accent-border: rgba(255, 107, 157, 0.3);
    --accent-purple: #c4a8ff;
    --accent-green: #b4f8c8;
    --accent-orange: #ffd93d;
    --accent-red: #ff5e7e;
    --accent-cyan: #7defff;

    --border: #3a2658;
    --border-subtle: #2d1b4a;
    --text: #f0e6ff;
    --text-secondary: #c4b8e0;
    --text-dim: #7a6a9e;

    --glow-pink: rgba(255, 107, 157, 0.15);
    --glow-purple: rgba(196, 168, 255, 0.12);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
}

.theme-moonlight .content-panel {
    background-color: #1a0e2e;
}

.theme-moonlight .pages-container {
    background-color: #1a0e2e;
}

.theme-moonlight .field-group {
    background-color: #241638;
    border-color: #2d1b4a;
}

.theme-moonlight .field-group-title {
    color: #c4a8ff;
    border-bottom-color: rgba(255, 107, 157, 0.15);
}

.theme-moonlight HelpBox {
    background-color: rgba(255, 107, 157, 0.08);
    border-color: rgba(255, 107, 157, 0.2);
    color: #c4b8e0;
}

.theme-moonlight .part-card {
    background-color: #241638;
    border-color: #2d1b4a;
}

.theme-moonlight .part-card:hover {
    border-color: #ff6b9d;
    background-color: #2e1d4a;
}

.theme-moonlight .fade-section {
    background-color: rgba(196, 168, 255, 0.08);
    border-color: #2d1b4a;
}

