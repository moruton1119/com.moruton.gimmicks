<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
  <Style src="MetamorphoseEditor.uss" />

  <ui:VisualElement name="root" class="metamorphose-root">

    <!-- ===== Header (IMGUI wrapped) ===== -->
    <ui:VisualElement name="header-container" class="header-container" />

    <!-- ===== Language Toolbar ===== -->
    <ui:VisualElement name="lang-bar" class="lang-bar">
      <ui:Button name="lang-btn-0" class="lang-btn selected" />
      <ui:Button name="lang-btn-1" class="lang-btn" />
      <ui:Button name="lang-btn-2" class="lang-btn" />
      <ui:Button name="lang-btn-3" class="lang-btn" />
      <ui:Button name="lang-btn-4" class="lang-btn" />
    </ui:VisualElement>

    <ui:VisualElement class="spacer-sm" />

    <!-- ===== Step 1: 基本設定 ===== -->
    <ui:VisualElement name="step1" class="step-section">
      <ui:Button name="step1-toggle" class="step-toggle expanded" />
      <ui:VisualElement name="step1-body" class="step-body">
        <ui:Label name="step1-desc" class="step-desc" />
        <ui:VisualElement class="spacer-sm" />
        <ui:Label name="step1-avatar-label" class="section-label" />
        <ui:VisualElement name="slot-avatar" />
        <ui:VisualElement name="slot-model" />
        <ui:VisualElement name="slot-animator" />
        <ui:VisualElement class="spacer-md" />
        <ui:Label name="step1-off-label" class="section-label" />
        <ui:VisualElement name="slot-offTargets" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer-xs" />

    <!-- ===== Step 2: 変身後の衣装 ===== -->
    <ui:VisualElement name="step2" class="step-section">
      <ui:Button name="step2-toggle" class="step-toggle" />
      <ui:VisualElement name="step2-body" class="step-body collapsed">
        <ui:Label name="step2-desc" class="step-desc" />
        <ui:VisualElement class="spacer-sm" />

        <!-- Unpack Section -->
        <ui:Label name="step2-unpack-label" class="section-label" />
        <ui:HelpBox name="step2-unpack-help" message-type="Info" />
        <ui:VisualElement name="slot-itemToUnpack" />
        <ui:Button name="btn-unpack" class="action-btn" text="Unpack Prefab" />

        <ui:VisualElement class="spacer-md" />

        <!-- Parts Section -->
        <ui:Label name="step2-parts-label" class="section-label" />
        <ui:HelpBox name="step2-parts-help" message-type="Info" />
        <ui:VisualElement class="spacer-sm" />

        <!-- Head -->
        <ui:VisualElement class="part-section">
          <ui:Label name="label-head-items" class="part-label" />
          <ui:VisualElement name="slot-headItems" />
          <ui:VisualElement name="head-preview" class="preview-row" />
        </ui:VisualElement>

        <!-- Body -->
        <ui:VisualElement class="part-section">
          <ui:Label name="label-body-items" class="part-label" />
          <ui:VisualElement name="slot-bodyItems" />
          <ui:VisualElement name="body-preview" class="preview-row" />
        </ui:VisualElement>

        <!-- Hand -->
        <ui:VisualElement class="part-section">
          <ui:Label name="label-hand-items" class="part-label" />
          <ui:VisualElement name="slot-handItems" />
          <ui:VisualElement name="hand-preview" class="preview-row" />
        </ui:VisualElement>

        <!-- Leg -->
        <ui:VisualElement class="part-section">
          <ui:Label name="label-leg-items" class="part-label" />
          <ui:VisualElement name="slot-legItems" />
          <ui:VisualElement name="leg-preview" class="preview-row" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer-xs" />

    <!-- ===== Step 3: ギミック色 ===== -->
    <ui:VisualElement name="step3" class="step-section">
      <ui:Button name="step3-toggle" class="step-toggle" />
      <ui:VisualElement name="step3-body" class="step-body collapsed">
        <ui:Label name="step3-desc" class="step-desc" />
        <ui:VisualElement class="spacer-sm" />
        <ui:VisualElement name="slot-gimmickColor" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer-xs" />

    <!-- ===== Step 4: コラボ・フェード演出 ===== -->
    <ui:VisualElement name="step4" class="step-section">
      <ui:Button name="step4-toggle" class="step-toggle" />
      <ui:VisualElement name="step4-body" class="step-body collapsed">
        <ui:Label name="step4-desc" class="step-desc" />
        <ui:VisualElement class="spacer-sm" />

        <!-- Colabo Shop Preview -->
        <ui:VisualElement name="colabo-image-container" class="colabo-preview" />
        <ui:Button name="btn-colabo-shop" class="link-btn" text="Open Shop" />

        <ui:HelpBox name="step4-colabo-help" message-type="Info" />
        <ui:VisualElement class="spacer-sm" />

        <!-- Fade Items (Transforms are in Developer Mode) -->
        <ui:Label name="step4-fade-label" class="section-label" />

        <ui:VisualElement class="fade-section">
          <ui:Label text="Head" class="fade-part-label" />
          <ui:VisualElement name="slot-fadeHeadItems" />
        </ui:VisualElement>

        <ui:VisualElement class="fade-section">
          <ui:Label text="Body" class="fade-part-label" />
          <ui:VisualElement name="slot-fadeBodyItems" />
        </ui:VisualElement>

        <ui:VisualElement class="fade-section">
          <ui:Label text="Arm" class="fade-part-label" />
          <ui:VisualElement name="slot-fadeArmItems" />
        </ui:VisualElement>

        <ui:VisualElement class="fade-section">
          <ui:Label text="Leg" class="fade-part-label" />
          <ui:VisualElement name="slot-fadeLegItems" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer-sm" />

    <!-- ===== Developer Mode ===== -->
    <ui:VisualElement name="devmode" class="step-section devmode-section">
      <ui:Button name="devmode-toggle" class="step-toggle devmode-toggle" text="Developer Mode" />
      <ui:VisualElement name="devmode-body" class="step-body collapsed">

        <!-- dev_basic_label -->
        <ui:Label name="dev-basic-label" class="section-label" />
        <ui:VisualElement name="slot-dummyImage" />
        <ui:VisualElement name="slot-colaboShopTex" />
        <ui:VisualElement name="slot-colaboShopInfo" />
        <ui:VisualElement name="slot-devmodel" />
        <ui:VisualElement name="slot-devanimator" />

        <ui:VisualElement class="spacer-sm" />

        <!-- dev_target_label -->
        <ui:Label name="dev-target-label" class="section-label" />
        <ui:VisualElement name="slot-devHeadTarget" />
        <ui:VisualElement name="slot-devBodyTarget" />
        <ui:VisualElement name="slot-devHandTarget" />
        <ui:VisualElement name="slot-devLegTarget" />
        <ui:VisualElement name="slot-devOnePiece" />
        <ui:VisualElement name="slot-devColaboItemTarget" />
        <ui:VisualElement name="slot-devColaboItem" />
        <ui:VisualElement name="slot-devColaboFBX" />

        <ui:VisualElement class="spacer-sm" />

        <!-- dev_fade_transform_label -->
        <ui:Label name="dev-fade-label" class="section-label" />
        <ui:VisualElement name="slot-devFadeHead" />
        <ui:VisualElement name="slot-devFadeBody" />
        <ui:VisualElement name="slot-devFadeArm" />
        <ui:VisualElement name="slot-devFadeLeg" />

        <ui:VisualElement class="spacer-sm" />

        <!-- dev_material_label -->
        <ui:Label name="dev-material-label" class="section-label" />
        <ui:VisualElement name="slot-devFadeHeadMaterial" />
        <ui:VisualElement name="slot-devFadeBodyMaterial" />
        <ui:VisualElement name="slot-devFadeArmMaterial" />
        <ui:VisualElement name="slot-devFadeLegMaterial" />

        <ui:VisualElement class="spacer-sm" />

        <!-- dev_gimmick_color_targets -->
        <ui:Label name="dev-gimmick-color-label" class="section-label" />
        <ui:VisualElement name="slot-gimmickCollar" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="spacer-md" />

    <!-- ===== Setup Button ===== -->
    <ui:Button name="btn-setup" class="setup-btn" text="Setup Transformation" />

  </ui:VisualElement>
</ui:UXML>
