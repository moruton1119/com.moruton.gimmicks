/* ═══════════════════════════════════════════════
   LIGHT THEME EXPLICIT OVERRIDES
   .theme-daylight 配下の全要素の色を明示的に上書き
   ═══════════════════════════════════════════════ */

/* ★ CSS変数の上書き — Daylight パレット
   アクセントをrose-pinkに統一してピンク背景と調和させる */
.theme-daylight {
    --bg-night: #fff5f8;
    --bg-deep: #ffe4ed;
    --bg-elevated: #ffffff;
    --bg-hover: #fce4ec;
    --bg-input: #fff0f4;
    --topbar-bg: #ffe4ed;
    --sidebar-bg: #ffd6e4;
    --banner-bg: #ffe4ed;

    --accent: #e91e63;
    --accent-hover: #f06292;
    --accent-bg: rgba(233, 30, 99, 0.08);
    --accent-border: rgba(233, 30, 99, 0.25);
    --accent-purple: #ad1457;
    --accent-green: #2e7d32;
    --accent-orange: #e65100;
    --accent-red: #c62828;
    --accent-cyan: #00838f;

    --border: #f8bbd0;
    --border-subtle: #fce4ec;

    --text: #4a1942;
    --text-secondary: #880e4f;
    --text-dim: #ad7baa;

    --glow-pink: rgba(233, 30, 99, 0.10);
    --glow-purple: rgba(173, 20, 87, 0.06);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
}

/* Content panel */
.theme-daylight .content-panel {
    background-color: #fff5f8;
}

/* Pages container */
.theme-daylight .pages-container {
    background-color: #fff5f8;
}

/* Page description */
.theme-daylight .page-desc {
    color: #880e4f;
}

/* Field Group */
.theme-daylight .field-group {
    background-color: #ffffff;
    border-color: #f8bbd0;
}

.theme-daylight .field-group-title {
    color: #ad1457;
    border-bottom-color: rgba(233, 30, 99, 0.2);
}

/* Part Section */
.theme-daylight .part-section {
    background-color: #fdf0f5;
    border-color: #f8bbd0;
}

.theme-daylight .part-label {
    color: #e91e63;
}

/* Fade Section */
.theme-daylight .fade-section {
    background-color: #fdf0f5;
    border-color: #f8bbd0;
}

.theme-daylight .fade-part-label {
    color: #e65100;
}

/* Dev Page field slots */
.theme-daylight .dev-page .field-slot > PropertyField > .unity-property-field__label {
    color: #880e4f;
}

/* Field Slot labels */
.theme-daylight .field-slot > PropertyField > .unity-property-field__label {
    color: #880e4f;
}

/* Nav buttons in light mode */
.theme-daylight .nav-num {
    background-color: #ffffff;
    color: #ad7baa;
    border-color: #f8bbd0;
}

.theme-daylight .nav-num:hover {
    background-color: #fce4ec;
    color: #4a1942;
}

.theme-daylight .nav-num.active {
    background-color: #e91e63;
    color: #ffffff;
    border-color: #e91e63;
}

/* Link buttons */
.theme-daylight .nav-link {
    background-color: #ffffff;
    color: #880e4f;
    border-color: #f8bbd0;
}

.theme-daylight .nav-link:hover {
    background-color: #fce4ec;
}

/* Dev button */
.theme-daylight .dev-btn {
    color: #e65100;
}

.theme-daylight .dev-btn:hover {
    background-color: rgba(230, 81, 0, 0.10);
}

.theme-daylight .dev-btn.active {
    background-color: #e65100;
    color: #ffffff;
}

/* Part toggle */
.theme-daylight .part-toggle {
    background-color: #e91e63;
}

.theme-daylight .part-toggle:hover {
    background-color: #f06292;
}

.theme-daylight .part-toggle-off {
    background-color: #fce4ec;
    color: #ad7baa;
}

/* Topbar */
.theme-daylight .topbar {
    background-color: #ffffff;
    border-bottom-color: #e91e63;
}

.theme-daylight .topbar-title {
    color: #e91e63;
}

/* Language bar */
.theme-daylight .lang-bar {
    background-color: #fce4ec;
}

.theme-daylight .lang-btn {
    color: #ad7baa;
}

.theme-daylight .lang-btn:hover {
    color: #4a1942;
    background-color: #f8bbd0;
}

.theme-daylight .lang-btn.selected {
    background-color: #e91e63;
    color: #ffffff;
}

/* Sidebar */
.theme-daylight .sidebar {
    background-color: #fce4ec;
    border-right-color: #e91e63;
}

.theme-daylight .sidebar-header {
    color: #e91e63;
}

/* Banner */
.theme-daylight .banner {
    background-color: #fce4ec;
    border-top-color: rgba(233, 30, 99, 0.3);
}

.theme-daylight .banner-card {
    background-color: #ffffff;
    border-color: #f8bbd0;
}

.theme-daylight .banner-card:hover {
    border-color: #e91e63;
    background-color: #fff5f8;
}

.theme-daylight .banner-card-label {
    color: #4a1942;
}

/* Theme toggle */
.theme-daylight .theme-toggle {
    color: #e91e63;
    background-color: rgba(233, 30, 99, 0.08);
    border-color: rgba(233, 30, 99, 0.25);
}

/* Link button */
.theme-daylight .link-btn {
    color: #e91e63;
    background-color: rgba(233, 30, 99, 0.08);
    border-color: rgba(233, 30, 99, 0.25);
}

/* Preview thumb */
.theme-daylight .preview-thumb {
    border-color: rgba(233, 30, 99, 0.25);
}

/* Colabo */
.theme-daylight .colabo-shop-image {
    border-color: rgba(233, 30, 99, 0.25);
}

/* HelpBox — USS fallback (C#でも上書きするが二重保险) */
.theme-daylight HelpBox {
    background-color: #fff8e1;
    border-color: rgba(233, 30, 99, 0.2);
    color: #880e4f;
}

/* Part card */
.theme-daylight .part-card {
    background-color: #ffffff;
    border-color: #f8bbd0;
}

.theme-daylight .part-card:hover {
    border-color: #e91e63;
    background-color: #fff5f8;
}

.theme-daylight .part-card-label {
    color: #e91e63;
}

/* ── Unity標準要素のライトモード上書き ── */

/* TextField 入力欄 */
.theme-daylight .unity-base-field__input {
    background-color: #fff0f4;
    border-color: #f8bbd0;
    color: #4a1942;
}

/* ObjectField */
.theme-daylight .unity-object-field {
    background-color: #fff0f4;
}

.theme-daylight .unity-object-field__object {
    background-color: #fff0f4;
    color: #4a1942;
}

/* Color Field */
.theme-daylight .unity-color-field {
    background-color: #fff0f4;
    border-color: #f8bbd0;
}

/* Integer/Float Field */
.theme-daylight .unity-integer-field,
.theme-daylight .unity-float-field {
    background-color: #fff0f4;
    color: #4a1942;
}

/* PropertyField label */
.theme-daylight .unity-property-field__label {
    color: #880e4f !important;
}

/* Foldout */
.theme-daylight .unity-foldout {
    color: #4a1942;
}

.theme-daylight .unity-foldout__text {
    color: #4a1942;
}

/* Toggle */
.theme-daylight .unity-toggle {
    color: #4a1942;
}

/* LayerMask Field */
.theme-daylight .unity-layer-mask-field {
    background-color: #fff0f4;
    border-color: #f8bbd0;
}

/* Array size field */
.theme-daylight .unity-array-size-field {
    background-color: #fff0f4;
}
