/* ═══════════════════════════════════════════════
   LIGHT THEME EXPLICIT OVERRIDES
   .theme-daylight 配下の全要素の色を明示的に上書き
   全色 CSS変数で制御 — ハードコードなし
   ═══════════════════════════════════════════════ */

/* ★ Daylight CSS変数定義 — 白基底 × 落ち着いたピンク */
.theme-daylight {
    --bg-night: #ffffff;
    --bg-deep: #fbf9f9;
    --bg-elevated: #ffffff;
    --bg-hover: #f7f3f4;
    --bg-input: #fcfbfb;
    --topbar-bg: #fbf9f9;
    --sidebar-bg: #f7f3f4;
    --banner-bg: #f7f3f4;
    --helpbox-bg: #f9f6f7;

    --accent: #d8869b;
    --accent-hover: #c9748b;
    --accent-bg: rgba(216, 134, 155, 0.08);
    --accent-border: rgba(216, 134, 155, 0.25);
    --accent-purple: #b48aab;
    --accent-green: #4caf50;
    --accent-orange: #e6941a;
    --accent-red: #e57373;
    --accent-cyan: #4db6ac;

    --border: #e6e1e1;
    --border-subtle: #f0ebec;

    --text: #403b3a;
    --text-secondary: #8c7c8c;
    --text-dim: #b4aab4;

    --glow-pink: rgba(216, 134, 155, 0.06);
    --glow-purple: rgba(180, 138, 171, 0.04);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
}

/* ═══════════════════════════════════════════════
   Layout elements — 全部 var() 参照
   ═══════════════════════════════════════════════ */

.theme-daylight .content-panel {
    background-color: var(--bg-night);
}

.theme-daylight .pages-container {
    background-color: var(--bg-night);
}

.theme-daylight .page-desc {
    color: var(--text-secondary);
}

/* Field Group */
.theme-daylight .field-group {
    background-color: var(--bg-elevated);
    border-color: var(--border);
}

.theme-daylight .field-group-title {
    color: var(--accent-purple);
    border-bottom-color: var(--accent-border);
}

/* Part Section */
.theme-daylight .part-section {
    background-color: var(--glow-purple);
    border-color: var(--border);
}

.theme-daylight .part-label {
    color: var(--accent);
}

/* Fade Section */
.theme-daylight .fade-section {
    background-color: var(--glow-purple);
    border-color: var(--border);
}

.theme-daylight .fade-part-label {
    color: var(--accent-orange);
}

/* Field Slot labels */
.theme-daylight .field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-secondary);
}

.theme-daylight .dev-page .field-slot > PropertyField > .unity-property-field__label {
    color: var(--text-secondary);
}

/* ═══════════════════════════════════════════════
   Navigation
   ═══════════════════════════════════════════════ */

.theme-daylight .nav-num {
    background-color: var(--bg-elevated);
    color: var(--text-dim);
    border-color: var(--border);
}

.theme-daylight .nav-num:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.theme-daylight .nav-num.active {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
}

.theme-daylight .nav-link {
    background-color: var(--bg-elevated);
    color: var(--text-secondary);
    border-color: var(--border);
}

.theme-daylight .nav-link:hover {
    background-color: var(--bg-hover);
}

.theme-daylight .dev-btn {
    color: var(--accent-orange);
}

.theme-daylight .dev-btn:hover {
    background-color: var(--accent-bg);
}

.theme-daylight .dev-btn.active {
    background-color: var(--accent-orange);
    color: #ffffff;
}

/* Part toggle */
.theme-daylight .part-toggle {
    background-color: var(--accent);
}

.theme-daylight .part-toggle:hover {
    background-color: var(--accent-hover);
}

.theme-daylight .part-toggle-off {
    background-color: var(--bg-hover);
    color: var(--text-dim);
}

/* ═══════════════════════════════════════════════
   Topbar / Language bar
   ═══════════════════════════════════════════════ */

.theme-daylight .topbar {
    background-color: var(--bg-elevated);
    border-bottom-color: var(--accent);
}

.theme-daylight .topbar-title {
    color: var(--accent);
}

.theme-daylight .lang-bar {
    background-color: var(--bg-hover);
}

.theme-daylight .lang-btn {
    color: var(--text-dim);
}

.theme-daylight .lang-btn:hover {
    color: var(--text);
    background-color: var(--border);
}

.theme-daylight .lang-btn.selected {
    background-color: var(--accent);
    color: #ffffff;
}

/* ═══════════════════════════════════════════════
   Sidebar / Banner
   ═══════════════════════════════════════════════ */

.theme-daylight .sidebar {
    background-color: var(--sidebar-bg);
    border-right-color: var(--accent);
}

.theme-daylight .sidebar-header {
    color: var(--accent);
}

.theme-daylight .banner {
    background-color: var(--banner-bg);
    border-top-color: var(--accent-border);
}

.theme-daylight .banner-card {
    background-color: var(--bg-elevated);
    border-color: var(--border);
}

.theme-daylight .banner-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-night);
}

.theme-daylight .banner-card-label {
    color: var(--text);
}

/* ═══════════════════════════════════════════════
   Buttons / Toggle / Preview
   ═══════════════════════════════════════════════ */

.theme-daylight .theme-toggle {
    color: var(--accent);
    background-color: var(--accent-bg);
    border-color: var(--accent-border);
}

.theme-daylight .link-btn {
    color: var(--accent);
    background-color: var(--accent-bg);
    border-color: var(--accent-border);
}

.theme-daylight .preview-thumb {
    border-color: var(--accent-border);
}

.theme-daylight .colabo-shop-image {
    border-color: var(--accent-border);
}

/* Part card */
.theme-daylight .part-card {
    background-color: var(--bg-elevated);
    border-color: var(--border);
}

.theme-daylight .part-card:hover {
    border-color: var(--accent);
    background-color: var(--bg-night);
}

.theme-daylight .part-card-label {
    color: var(--accent);
}

/* ═══════════════════════════════════════════════
   Unity標準要素のライトモード上書き
   ═══════════════════════════════════════════════ */

/* HelpBox */
.theme-daylight HelpBox {
    background-color: var(--helpbox-bg);
    border-color: var(--accent-border);
    color: var(--text-secondary);
}

/* TextField / ObjectField 入力欄 */
.theme-daylight .unity-base-field__input {
    background-color: var(--bg-input);
    border-color: var(--border);
    color: var(--text);
}

.theme-daylight .unity-object-field {
    background-color: var(--bg-input);
}

.theme-daylight .unity-object-field__object {
    background-color: var(--bg-input);
    color: var(--text);
}

.theme-daylight .unity-color-field {
    background-color: var(--bg-input);
    border-color: var(--border);
}

.theme-daylight .unity-integer-field,
.theme-daylight .unity-float-field {
    background-color: var(--bg-input);
    color: var(--text);
}

.theme-daylight .unity-layer-mask-field {
    background-color: var(--bg-input);
    border-color: var(--border);
}

.theme-daylight .unity-array-size-field {
    background-color: var(--bg-input);
}

/* PropertyField label */
.theme-daylight .unity-property-field__label {
    color: var(--text-secondary) !important;
}

/* Foldout */
.theme-daylight .unity-foldout {
    color: var(--text);
}

.theme-daylight .unity-foldout__text {
    color: var(--text);
}

/* Toggle */
.theme-daylight .unity-toggle {
    color: var(--text);
}

/* ═══════════════════════════════════════════════
   配列・リスト要素 (ReorderableList)
   ═══════════════════════════════════════════════ */

/* リスト全体の背景 */
.theme-daylight .unity-list-view {
    background-color: var(--bg-input);
    border-color: var(--border-subtle);
}

/* 個別の配列要素 */
.theme-daylight .unity-list-view__reorderable-item {
    background-color: var(--bg-elevated);
    border-color: var(--border-subtle);
}

.theme-daylight .unity-list-view__reorderable-item:hover {
    background-color: var(--bg-hover);
}

/* ドラッグハンドル */
.theme-daylight .unity-list-view__reorderable-item__drag-handle {
    background-color: var(--border);
}

.theme-daylight .unity-list-view__reorderable-item__drag-handle:hover {
    background-color: var(--accent);
}

/* 削除ボタン */
.theme-daylight .unity-list-view__reorderable-item__remove-button {
    color: var(--text-dim);
    background-color: transparent;
}

.theme-daylight .unity-list-view__reorderable-item__remove-button:hover {
    color: var(--accent-red);
    background-color: var(--bg-hover);
}

/* 配列のサイズ変更フィールド */
.theme-daylight .unity-array-size-field__input {
    background-color: var(--bg-input);
    color: var(--text);
}

/* Foldout（配列の折りたたみヘッダー） */
.theme-daylight .unity-foldout__toggle {
    color: var(--accent);
}

/* ScrollView内のリストスクロールバー */
.theme-daylight .unity-scroll-view {
    background-color: transparent;
}
