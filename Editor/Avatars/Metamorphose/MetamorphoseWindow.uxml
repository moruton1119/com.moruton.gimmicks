<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
  <Style src="MetamorphoseWindow.uss" />
  <Style src="Theme_Moonlight.uss" />
  <Style src="Theme_Daylight.uss" />

  <ui:VisualElement name="app" class="app-root">

    <!-- ===== Top Bar ===== -->
    <ui:VisualElement name="topbar" class="topbar">
      <ui:VisualElement class="topbar-left" style="flex-direction: row; align-items: center;">
        <ui:Label name="topbar-title" class="topbar-title" text="✦ Metamorphose Setup" />
      </ui:VisualElement>
      <ui:VisualElement class="topbar-right" style="flex-direction: row; align-items: center;">
        <ui:Button name="theme-toggle" class="theme-toggle" text="🌙" tooltip="Toggle Light/Dark Theme" />
        <ui:VisualElement name="lang-bar" class="lang-bar">
          <ui:Button name="lang-btn-0" class="lang-btn selected" />
          <ui:Button name="lang-btn-1" class="lang-btn" />
          <ui:Button name="lang-btn-2" class="lang-btn" />
          <ui:Button name="lang-btn-3" class="lang-btn" />
          <ui:Button name="lang-btn-4" class="lang-btn" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- ===== Main Area ===== -->
    <ui:VisualElement name="main" class="main-area">

      <!-- Sidebar -->
      <ui:VisualElement name="sidebar" class="sidebar">
        <ui:Label class="sidebar-header" text="MENU" />

        <ui:Button name="btn-booth" class="nav-link" text="Booth" />
        <ui:Button name="btn-discord" class="nav-link" text="Discord" />
        <ui:Button name="btn-colabo" class="nav-link" text="Colabo" />

        <ui:VisualElement class="sidebar-spacer" />

        <ui:Button name="nav-3" class="nav-link dev-btn" text="Dev" />
      </ui:VisualElement>

      <!-- Content -->
      <ui:VisualElement name="content" class="content-panel">
        <ui:ScrollView name="scroll-content">
          <ui:VisualElement name="pages-container" class="pages-container">

            <!-- ===== Main Page ===== -->
            <ui:VisualElement name="page-main" class="page">

              <!-- 変身前の衣装 -->
              <ui:VisualElement name="section-off" class="field-group outfit-section">
                <ui:Label name="fg-off-title" class="field-group-title" text="◆ 変身前の衣装" />
                <ui:VisualElement name="page0-slot-offTargets" class="field-slot" />
                <ui:VisualElement name="off-preview" class="preview-row" />
              </ui:VisualElement>

              <!-- 変身後の衣装 -->
              <ui:VisualElement name="section-after" class="field-group">
                <ui:Label name="fg-after-title" class="field-group-title" text="◆ 変身後の衣装" />
                <ui:HelpBox name="page1-help" message-type="Info" />

                <ui:VisualElement name="parts-grid" class="parts-grid">

                  <ui:VisualElement name="section-head" class="part-card">
                    <ui:Label name="label-head" class="part-card-label" text="Head" />
                    <ui:VisualElement name="page0-slot-headItems" class="field-slot" />
                    <ui:VisualElement name="head-preview" class="preview-row" />
                  </ui:VisualElement>

                  <ui:VisualElement name="section-body" class="part-card">
                    <ui:Label name="label-body" class="part-card-label" text="Body" />
                    <ui:VisualElement name="page0-slot-bodyItems" class="field-slot" />
                    <ui:VisualElement name="body-preview" class="preview-row" />
                  </ui:VisualElement>

                  <ui:VisualElement name="section-hand" class="part-card">
                    <ui:Label name="label-hand" class="part-card-label" text="Hand" />
                    <ui:VisualElement name="page0-slot-handItems" class="field-slot" />
                    <ui:VisualElement name="hand-preview" class="preview-row" />
                  </ui:VisualElement>

                  <ui:VisualElement name="section-leg" class="part-card">
                    <ui:Label name="label-leg" class="part-card-label" text="Leg" />
                    <ui:VisualElement name="page0-slot-legItems" class="field-slot" />
                    <ui:VisualElement name="leg-preview" class="preview-row" />
                  </ui:VisualElement>

                </ui:VisualElement>
              </ui:VisualElement>

              <!-- ギミック色 -->
              <ui:VisualElement name="section-color" class="field-group">
                <ui:Label name="fg-color-title" class="field-group-title" text="◆ ギミック色" />
                <ui:VisualElement name="page0-slot-gimmickColor" class="field-slot" />
              </ui:VisualElement>

              <!-- Avatar -->
              <ui:VisualElement name="section-avatar" class="field-group">
                <ui:Label name="fg-avatar-title" class="field-group-title" text="◆ Avatar" />
                <ui:VisualElement name="page0-slot-avatar" class="field-slot" />
                <ui:Button name="btn-generate-anim" class="link-btn" text="Generate Animation" />
              </ui:VisualElement>

            </ui:VisualElement>

            <!-- ===== Colabo Page ===== -->
            <ui:VisualElement name="page-colabo" class="page" style="display: none;">

              <!-- コラボショップ -->
              <ui:VisualElement name="section-colabo-shop" class="field-group">
                <ui:Label name="fg-colabo-title" class="field-group-title" text="◆ コラボ情報" />
                <ui:VisualElement name="colabo-image-container" class="colabo-preview" />
                <ui:Button name="btn-colabo-shop" class="link-btn" text="Open Shop" />
                <ui:HelpBox name="colabo-help" message-type="Info" />
              </ui:VisualElement>

              <!-- フェード演出 -->
              <ui:VisualElement name="section-fade" class="field-group">
                <ui:Label name="fg-fade-title" class="field-group-title" text="◆ フェード演出" />

                <ui:VisualElement name="section-fadeHead" class="fade-section">
                  <ui:Label text="Head" class="fade-part-label" />
                  <ui:VisualElement name="page2-slot-fadeHeadItems" class="field-slot" />
                </ui:VisualElement>
                <ui:VisualElement name="section-fadeBody" class="fade-section">
                  <ui:Label text="Body" class="fade-part-label" />
                  <ui:VisualElement name="page2-slot-fadeBodyItems" class="field-slot" />
                </ui:VisualElement>
                <ui:VisualElement name="section-fadeArm" class="fade-section">
                  <ui:Label text="Arm" class="fade-part-label" />
                  <ui:VisualElement name="page2-slot-fadeArmItems" class="field-slot" />
                </ui:VisualElement>
                <ui:VisualElement name="section-fadeLeg" class="fade-section">
                  <ui:Label text="Leg" class="fade-part-label" />
                  <ui:VisualElement name="page2-slot-fadeLegItems" class="field-slot" />
                </ui:VisualElement>
              </ui:VisualElement>

            </ui:VisualElement>

            <!-- ===== Dev Page ===== -->
            <ui:VisualElement name="page-3" class="page dev-page" style="display: none;">
              <ui:Label name="fg3-basic" class="field-group-title" />
              <ui:VisualElement name="page3-slot-dummyImage" class="field-slot" />
              <ui:VisualElement name="page3-slot-colaboShopTex" class="field-slot" />
              <ui:VisualElement name="page3-slot-colaboShopInfo" class="field-slot" />
              <ui:VisualElement name="page3-slot-model" class="field-slot" />
              <ui:VisualElement name="page3-slot-animator" class="field-slot" />

              <ui:Label name="fg3-targets" class="field-group-title" />
              <ui:VisualElement name="page3-slot-devHeadTarget" class="field-slot" />
              <ui:VisualElement name="page3-slot-devBodyTarget" class="field-slot" />
              <ui:VisualElement name="page3-slot-devHandTarget" class="field-slot" />
              <ui:VisualElement name="page3-slot-devLegTarget" class="field-slot" />
              <ui:VisualElement name="page3-slot-devOnePiece" class="field-slot" />
              <ui:VisualElement name="page3-slot-devColaboItemTarget" class="field-slot" />
              <ui:VisualElement name="page3-slot-devColaboItem" class="field-slot" />
              <ui:VisualElement name="page3-slot-devColaboFBX" class="field-slot" />

              <ui:Label name="fg3-items-toggle" class="field-group-title" text="部位表示切替" />
              <ui:VisualElement class="dev-toggle-grid">
                <ui:Button name="toggle-head" class="part-toggle" text="Head: ON" />
                <ui:Button name="toggle-body" class="part-toggle" text="Body: ON" />
                <ui:Button name="toggle-hand" class="part-toggle" text="Hand: ON" />
                <ui:Button name="toggle-leg" class="part-toggle" text="Leg: ON" />
              </ui:VisualElement>

              <ui:Label name="fg3-fade-toggle" class="field-group-title" text="フェード部位表示切替" />
              <ui:VisualElement class="dev-toggle-grid">
                <ui:Button name="toggle-fadeHead" class="part-toggle" text="F-Head: ON" />
                <ui:Button name="toggle-fadeBody" class="part-toggle" text="F-Body: ON" />
                <ui:Button name="toggle-fadeArm" class="part-toggle" text="F-Arm: ON" />
                <ui:Button name="toggle-fadeLeg" class="part-toggle" text="F-Leg: ON" />
              </ui:VisualElement>

              <ui:Label name="fg3-fade-transforms" class="field-group-title" />
              <ui:VisualElement name="page3-slot-devFadeHead" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeBody" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeArm" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeLeg" class="field-slot" />

              <ui:Label name="fg3-materials" class="field-group-title" />
              <ui:VisualElement name="page3-slot-devFadeHeadMaterial" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeBodyMaterial" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeArmMaterial" class="field-slot" />
              <ui:VisualElement name="page3-slot-devFadeLegMaterial" class="field-slot" />

              <ui:Label name="fg3-gimmick-color" class="field-group-title" />
              <ui:VisualElement name="page3-slot-gimmickCollar" class="field-slot" />

              <ui:Label name="fg3-banner" class="field-group-title" />
              <ui:VisualElement name="page3-slot-bannerAdUrls" class="field-slot" />

              <ui:Label name="fg3-editor-theme" class="field-group-title" text="✦ Editor Theme" />
              <ui:VisualElement name="page3-slot-editorTheme" class="field-slot" />
            </ui:VisualElement>

          </ui:VisualElement>
        </ui:ScrollView>
      </ui:VisualElement>

    </ui:VisualElement>

    <!-- ===== Bottom Banner ===== -->
    <ui:VisualElement name="banner" class="banner">
      <ui:VisualElement name="banner-cards" class="banner-cards" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
