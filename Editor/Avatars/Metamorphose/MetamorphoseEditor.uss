/* ============================================
   MetamorphoseEditor — Magical Girl Theme
   🌙 Dark (Moonlight) / ☀️ Light (Daylight)
   Inspector / SerializedObject Editor
   ============================================ */

/* ═══════════════════════════════════════════════
   DARK THEME (Moonlight) — Default
   ═══════════════════════════════════════════════ */
.metamorphose-root {
    --bg-primary: #1a0e2e;
    --bg-secondary: #241638;
    --bg-tertiary: #2e1d4a;
    --bg-hover: #2e1d4a;
    --bg-input: #1c1130;
    --text-primary: #f0e6ff;
    --text-secondary: #c4b8e0;
    --text-dim: #7a6a9e;
    --accent-blue: #ff6b9d;
    --accent-purple: #c4a8ff;
    --accent-green: #b4f8c8;
    --accent-green-hover: #c8ffd8;
    --accent-orange: #ffd93d;
    --border-subtle: #2d1b4a;
    --border-dim: #241638;
    --glow-pink: rgba(255, 107, 157, 0.12);
    --glow-purple: rgba(196, 168, 255, 0.08);
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;

    background-color: var(--bg-primary);
    color: var(--text-primary);
    padding: 4px;
    font-size: 13px;
}

/* ═══════════════════════════════════════════════
   LIGHT THEME (Daylight)
   ═══════════════════════════════════════════════ */
.metamorphose-root.light-theme {
    --bg-primary: #fff5f8;
    --bg-secondary: #ffffff;
    --bg-tertiary: #f3d4e6;
    --bg-hover: #f3d4e6;
    --bg-input: #fdf0f5;
    --text-primary: #4a1942;
    --text-secondary: #7b4a6e;
    --text-dim: #b0809e;
    --accent-blue: #e91e63;
    --accent-purple: #9c27b0;
    --accent-green: #66bb6a;
    --accent-green-hover: #81c784;
    --accent-orange: #ffa726;
    --border-subtle: #e8c4d8;
    --border-dim: #f0d4e2;
    --glow-pink: rgba(233, 30, 99, 0.06);
    --glow-purple: rgba(156, 39, 176, 0.05);
}

/* --- Header --- */
.header-container {
    margin-bottom: 4px;
}

/* --- Language Bar --- */
.lang-bar {
    flex-direction: row;
    background-color: var(--bg-input);
    border-radius: var(--radius-md);
    padding: 3px;
    margin: 4px 0;
}

.lang-btn {
    flex: 1;
    height: 26px;
    font-size: 12px;
    color: var(--text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: normal;
    margin-left: 1px;
    margin-right: 1px;
    transition: background-color 0.15s, color 0.15s;
}

.lang-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
}

.lang-btn.selected {
    color: #ffffff;
    background-color: var(--accent-blue);
    -unity-font-style: bold;
}

/* --- Spacers --- */
.spacer-xs { height: 4px; }
.spacer-sm { height: 8px; }
.spacer-md { height: 16px; }

/* --- Step Section --- */
.step-section {
    flex-direction: column;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: var(--radius-sm);
    margin-bottom: 2px;
    transition: border-left-color 0.15s;
}

.step-section:hover {
    border-left-color: var(--accent-blue);
}

/* --- Step Toggle Button --- */
.step-toggle {
    height: 34px;
    font-size: 13px;
    color: var(--text-secondary);
    background-color: var(--bg-secondary);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 12px;
    margin-bottom: 2px;
    transition: background-color 0.15s, color 0.15s;
}

.step-toggle:hover {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
}

.step-toggle.expanded {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: #ffffff;
    background-color: var(--accent-blue);
    border-color: var(--accent-blue);
}

/* --- Step Body --- */
.step-body {
    background-color: var(--bg-input);
    border-radius: 0 var(--radius-sm) var(--radius-sm) var(--radius-sm);
    padding: 10px 12px;
    flex-direction: column;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--border-subtle);
}

.step-body.collapsed {
    display: none;
}

/* --- Description Label --- */
.step-desc {
    color: var(--text-secondary);
    font-size: 12px;
    white-space: normal;
    -unity-font-style: normal;
    margin-bottom: 4px;
}

/* --- Section Label --- */
.section-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--accent-purple);
    margin-bottom: 4px;
    margin-top: 8px;
    padding-bottom: 2px;
    border-bottom-width: 2px;
    border-bottom-color: var(--glow-pink);
}

/* --- Part Section --- */
.part-section {
    background-color: var(--glow-purple);
    border-radius: var(--radius-sm);
    padding: 8px;
    margin-bottom: 4px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent-blue);
    margin-bottom: 2px;
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --- Preview Row --- */
.preview-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    align-items: center;
}

.preview-thumb {
    width: 80px;
    height: 80px;
    margin: 2px;
    border-radius: var(--radius-sm);
    border-width: 2px;
    border-color: var(--accent-blue);
    object-fit: scale-down;
    opacity: 0.95;
}

.preview-more {
    font-size: 11px;
    color: var(--text-dim);
    margin-left: 8px;
}

/* --- Part Toggle Button --- */
.part-toggle {
    height: 24px;
    font-size: 11px;
    color: #ffffff;
    background-color: var(--accent-blue);
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 8px;
    margin-bottom: 4px;
    transition: background-color 0.15s;
}

.part-toggle:hover {
    background-color: var(--accent-green);
}

.part-toggle-off {
    color: var(--text-dim);
    background-color: var(--bg-input);
}

.part-toggle-off:hover {
    background-color: var(--bg-hover);
}

/* --- Items Row (wraps label + slot + preview) --- */
.items-row {
    flex-direction: column;
}

/* --- Item Toggle (Step 3) --- */
.item-toggle {
    height: 24px;
    font-size: 11px;
    color: #ffffff;
    background-color: var(--accent-green);
    border-width: 0;
    border-radius: var(--radius-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 8px;
    margin-bottom: 4px;
    transition: background-color 0.15s;
}

.item-toggle:hover {
    background-color: var(--accent-green-hover);
}

.item-toggle.part-toggle-off {
    color: var(--text-dim);
    background-color: var(--bg-input);
}

/* --- Fade Section --- */
.dev-toggle-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.dev-toggle-grid > .part-toggle {
    flex: 1;
    min-width: 80px;
    margin: 2px;
}

.fade-section {
    background-color: var(--glow-purple);
    border-radius: var(--radius-sm);
    padding: 8px;
    margin-bottom: 4px;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--border-subtle);
}

.fade-part-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--accent-orange);
    margin-bottom: 4px;
    text-transform: uppercase;
}

/* --- Colabo Preview --- */
.colabo-preview {
    justify-content: center;
    align-items: center;
    height: 128px;
    margin-bottom: 4px;
}

.colabo-shop-image {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-md);
    border-width: 2px;
    border-color: var(--accent-blue);
}

/* --- Action Button --- */
.action-btn {
    height: 28px;
    font-size: 12px;
    color: #ffffff;
    background-color: var(--accent-blue);
    border-width: 0;
    border-radius: var(--radius-sm);
    margin-top: 4px;
    transition: background-color 0.15s;
}

.action-btn:hover {
    background-color: var(--accent-purple);
}

/* --- Link Button --- */
.link-btn {
    height: 30px;
    font-size: 12px;
    color: var(--accent-blue);
    background-color: var(--glow-pink);
    border-width: 1px;
    border-color: var(--accent-blue);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s;
}

.link-btn:hover {
    background-color: rgba(255, 107, 157, 0.2);
}

/* --- Setup Button --- */
.setup-btn {
    height: 46px;
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffffff;
    background-color: var(--accent-blue);
    border-width: 0;
    border-radius: var(--radius-lg);
    margin-top: 4px;
    transition: background-color 0.15s;
}

.setup-btn:hover {
    background-color: var(--accent-purple);
}

/* --- Developer Mode --- */
.devmode-section {
    opacity: 0.7;
}

.devmode-section:hover {
    opacity: 1;
}

.devmode-toggle {
    color: var(--text-dim);
    background-color: var(--glow-purple);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.devmode-toggle:hover {
    color: var(--text-secondary);
    background-color: var(--bg-hover);
}

.devmode-toggle.expanded {
    background-color: var(--bg-hover);
    color: var(--accent-purple);
}

.dev-btn {
    height: 30px;
    font-size: 12px;
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
    border-width: 0;
    border-radius: var(--radius-sm);
    margin-bottom: 4px;
    transition: background-color 0.15s;
}

.dev-btn:hover {
    background-color: var(--bg-hover);
}

/* --- PropertyField Override --- */
.step-body > PropertyField {
    margin-bottom: 2px;
}

.step-body > PropertyField > .unity-property-field__label {
    color: var(--text-secondary);
    min-width: 80px;
}

.step-body > PropertyField > .unity-base-field {
    background-color: var(--bg-input);
}

/* --- HelpBox Override --- */
.step-body > HelpBox {
    margin-top: 4px;
    margin-bottom: 6px;
}
